{
  "name": "perfumolandia-desktop",
  "productName": "Perfumolandia",
  "version": "1.0.0",
  "description": "Perfumolandia para Windows",
  "main": "main.js",
  "private": true,
  "author": "Perfumolandia",
  "scripts": {
    "start": "electron .",
    "dist": "node ../scripts/copy-dist.mjs && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.perfumolandia.app",
    "productName": "Perfumolandia",
    "files": [
      "main.js",
      "preload.js",
      "keymap.js",
      "dist/**",
      "icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Perfumolandia",
      "artifactName": "Perfumolandia-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Perfumolandia-Portatil-${version}.exe"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
