{
  "name": "perfumolandia-desktop",
  "productName": "Perfumolandia",
  "version": "1.10.0",
  "description": "Perfumolandia para Windows",
  "main": "main.js",
  "private": true,
  "author": "Perfumolandia",
  "scripts": {
    "start": "electron .",
    "dist": "node ../scripts/copy-dist.mjs && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.perfumolandia.app",
    "productName": "Perfumolandia",
    "files": [
      "main.js",
      "preload.js",
      "keymap.js",
      "updater.js",
      "games.js",
      "splash.html",
      "dist/**",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      { "from": "audiocap.exe", "to": "audiocap.exe" },
      { "from": "inputctl.exe", "to": "inputctl.exe" },
      { "from": "procwatch.exe", "to": "procwatch.exe" }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/yakult7/perfumolandia/releases/latest/download"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Perfumolandia",
      "artifactName": "Perfumolandia-Setup.${ext}"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  }
}
